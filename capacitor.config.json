{
  "appId": "uk.matchmuster.mobile",
  "appName": "MatchMuster",
  "webDir": "dist",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ]
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": true,
        "twitter": false
      }
    }
  }
}
